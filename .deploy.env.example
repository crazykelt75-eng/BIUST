# Copy to .deploy.env (gitignored), fill in, then: ./scripts/deploy.sh
#
# The database side is ALREADY PROVISIONED on the shared Supabase project
# (schema kraal, project hqnwxckuptagvsizanho): migrations applied, RLS forced,
# triggers verified, zones + test admin seeded. Two things remain for you:
#
#   1. Set the kraal_app password (once, in the Supabase SQL editor):
#        ALTER ROLE kraal_app PASSWORD 'choose-a-strong-password';
#   2. Fill this file in and run the script.

# Runtime — the kraal_app role through the transaction pooler (port 6543).
# Its server-side search_path routes queries into the kraal schema.
DATABASE_URL="postgresql://kraal_app.hqnwxckuptagvsizanho:<KRAAL_APP_PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations only — SESSION POOLER (port 5432 on the pooler host).
#
# NOT db.<ref>.supabase.co: that host is IPv6-only and unreachable from GitHub
# Actions and most CI. The session pooler is IPv4 and supports everything a
# direct connection does (DDL, prepared statements) — unlike the transaction
# pooler on 6543.
#
# ?schema=kraal is REQUIRED: it is how Prisma finds its history table in this
# shared database. Username is tenant-qualified: postgres.<ref>.
# Copy the exact host from: Supabase dashboard → Connect → Session pooler.
DIRECT_URL="postgresql://postgres.hqnwxckuptagvsizanho:<POSTGRES_DB_PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?schema=kraal"

# openssl rand -base64 32
OTP_PEPPER=""

# R2 (after enabling R2 in the Cloudflare dashboard and creating a bucket+token).
# Leave blank to deploy without photo upload for now.
S3_ENDPOINT=""            # https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET="kraal-photos"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Africa's Talking. Leave blank for test mode (codes go to the worker log).
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID=""

# Already seeded as an ADMIN in the database: +26771000000. Sign in with
# 71000000 via the normal OTP flow. This var only matters for re-seeding.
SEED_ADMIN_PHONE="71000000"
