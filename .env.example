# Copy to .env and fill in. Never commit .env.

DATABASE_URL="postgresql://kraal:kraal@127.0.0.1:5432/kraal?schema=public"

# Server-side salt for OTP hashing. REQUIRED in production, minimum 16 chars.
# Without it a leaked database yields a rainbow table of one million entries,
# which is no protection at all for a 6-digit code.
# Generate with: openssl rand -base64 32
OTP_PEPPER=""

# Object storage for listing photos. All four required in production;
# without them the app falls back to the local filesystem in development
# and refuses to start in production.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"
# CDN origin in front of the bucket, if there is one.
S3_PUBLIC_BASE_URL=""

# Migrations only — Supabase direct connection, port 5432.
# The transaction pooler cannot run DDL.
DIRECT_URL=""

# SMS gateway (Africa's Talking). Required in production — the app refuses to
# fall back to logging one-time codes.
AT_API_KEY=""
AT_USERNAME=""
AT_SENDER_ID=""
AT_SANDBOX="false"
