# Copy to .env and fill in. Never commit .env.

DATABASE_URL="postgresql://kraal:kraal@127.0.0.1:5432/kraal?schema=public"

# Server-side salt for OTP hashing. REQUIRED in production, minimum 16 chars.
# Without it a leaked database yields a rainbow table of one million entries,
# which is no protection at all for a 6-digit code.
# Generate with: openssl rand -base64 32
OTP_PEPPER=""
